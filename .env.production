# Production / distribution build env — COMMITTED, must contain NO secrets.
# Vite loads this AFTER .env for `vite build`, so these blanks override the dev
# values in your (gitignored) .env. Result: the packaged app ships with zero
# baked keys. Users add their own OpenRouter key in Settings; without Aura creds
# the graph falls back to local leads / sample data.

VITE_OPENROUTER_API_KEY=
VITE_NEO4J_URI=
VITE_NEO4J_USERNAME=
VITE_NEO4J_PASSWORD=
VITE_NEO4J_DATABASE=
VITE_NEO4J_INSTANCE_NAME=
