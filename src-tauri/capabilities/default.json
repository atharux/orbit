{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://venue-scraper.athar-hafiz.workers.dev/*" },
        { "url": "https://nominatim.openstreetmap.org/*" }
      ]
    }
  ]
}
