# Pocket Leads — environment config
# Copy to .env and fill in values

# Local SQLite API server (run: npm run local-api)
# When set, leads are persisted to SQLite on disk instead of localStorage
VITE_LEAD_API_URL=http://localhost:8787

# Path to SQLite DB file (used by local-api-server.mjs)
# Defaults to ./data/leads.db — set to an external drive for true pocket storage
# LEAD_DB_PATH=/Volumes/1a1/pocket-leads/leads.db

# Scraper worker override (leave blank to use the production fallback)
# VITE_SCRAPER_URL=http://localhost:8788

# OpenRouter (optional — for AI enrichment via the scraper worker)
# VITE_OPENROUTER_API_KEY=sk-or-...

# ---------------------------------------------------------------------------
# GraphRAG layer (Neo4j Aura) — used by scripts/ and mcp/, NOT the frontend.
# Consumed by the Python loader and the MCP servers, never bundled into the app.
# ---------------------------------------------------------------------------
NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
OPENAI_API_KEY=

# --- Immersive graph view (frontend, browser) ---
# Same Aura instance, but VITE_-prefixed so the 3D graph overlay can read it.
# When all three are set, the "◇ Graph" view loads LIVE data from Aura;
# otherwise it falls back to your local leads, then to SAMPLE data.
# WARNING: these ship in the JS bundle — use a throwaway READ-ONLY Aura user.
VITE_NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
VITE_NEO4J_USERNAME=neo4j
VITE_NEO4J_PASSWORD=
